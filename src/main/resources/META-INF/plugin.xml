<idea-plugin>
    <id>io.github.noodles_studio.revisiongraph</id>
    <name>Revision Graph</name>
    <vendor>Noodles Studio</vendor>
    <description><![CDATA[An interactive, native IntelliJ revision graph backed by Git.]]></description>
    <resource-bundle>messages.RevisionGraphBundle</resource-bundle>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Revision Graph" anchor="right"
                    icon="io.github.noodles_studio.revisiongraph.icons.RevisionGraphIcons.ToolWindow"
                    factoryClass="io.github.noodles_studio.revisiongraph.ui.RevisionGraphToolWindowFactory"
                    canCloseContents="false"/>
    </extensions>

    <actions>
        <action id="io.github.noodles_studio.revisiongraph.Open"
                class="io.github.noodles_studio.revisiongraph.ui.OpenRevisionGraphAction"
                icon="io.github.noodles_studio.revisiongraph.icons.RevisionGraphIcons.ToolWindow"
                text="%action.open.text" description="%action.open.description">
            <add-to-group group-id="Git.Menu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
